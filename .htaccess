# URLs limpas: /eventos -> index.php?p=eventos
#
# As regras sao relativas a pasta onde este arquivo esta, entao funcionam
# tanto na raiz do dominio (https://aaat.org/) quanto em uma subpasta
# (http://localhost/aaat/) sem nenhuma alteracao.

RewriteEngine On

# Bloqueia acesso direto aos arquivos internos do layout
RewriteRule ^(layout|partials|pages|conteudo)/ - [F,L]
RewriteRule ^config\.php$ - [F,L]

# Arquivos e pastas que existem (css, js, img, img2, Docs, favico)
# continuam sendo servidos direto, sem passar pelo index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/?$ index.php?p=$1 [QSA,L]

DirectoryIndex index.php

# Nota: nao criar rotas com o mesmo nome de uma pasta existente
# (css, js, img, img2, Docs, favico). Em sistemas que nao diferenciam
# maiusculas, a condicao !-d acima impediria a reescrita - foi por isso
# que a rota de documentos se chama "documentos", e nao "docs".
